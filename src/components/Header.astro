---
// Header mit Wordmark links und Slide-Tabs-Nav rechts
// Sticky-Background, das beim Scrollen dunkler wird
---

<header class="site-header" id="siteHeader">
  <div class="container inner">
    <a href="/" class="wordmark" aria-label="Dennis Klincov · Startseite">
      <span class="wm-name">Dennis Klincov</span>
    </a>
    <nav aria-label="Hauptnavigation">
      <ul class="slide-tabs" id="slideTabs">
        <li class="tab-cursor"></li>
        <a href="/#gruende" class="tab-item">Warum</a>
        <a href="/#erfahrung" class="tab-item">Erfahrung</a>
        <a href="/#schwerpunkte" class="tab-item">Schwerpunkte</a>
        <a href="/#dionysus" class="tab-item">Dionysus</a>
        <a href="/#bewerbung" class="tab-item cta">Mandant werden</a>
      </ul>
    </nav>
    <a href="/#bewerbung" class="mobile-cta">Mandant werden</a>
  </div>
</header>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(20, 8, 15, 0.30);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    border-bottom: 1px solid var(--border-on-dark);
    transition: background 300ms var(--ease-editorial);
  }
  .site-header.scrolled { background: rgba(20, 8, 15, 0.88); }
  .site-header .inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 84px;
  }
  .wordmark {
    text-decoration: none;
    display: flex; flex-direction: column;
    align-items: center; gap: 0;
    line-height: 1;
  }
  .wordmark .wm-name {
    font-family: var(--font-headline); font-weight: 500;
    font-size: 19px; letter-spacing: -0.2px;
    color: var(--marble); line-height: 1.1;
  }

  .slide-tabs {
    position: relative; display: flex;
    list-style: none; padding: 5px;
    border-radius: 999px;
    background: rgba(20, 8, 15, 0.4);
    border: 1px solid var(--border-gold);
  }
  .tab-item {
    position: relative; z-index: 2;
    padding: 9px 18px;
    font-family: var(--font-mono); font-weight: 500;
    font-size: 11px; text-transform: uppercase; letter-spacing: 1.6px;
    color: var(--text-on-dark); cursor: pointer;
    transition: color 200ms var(--ease-editorial);
    text-decoration: none; display: inline-flex; align-items: center;
    border-radius: 999px;
  }
  .tab-item.cta {
    color: var(--wine-deep);
    background: var(--gold-500); font-weight: 600;
  }
  .tab-item.cta:hover { color: var(--wine-deep); }
  .tab-item:hover { color: var(--gold-300); }
  .tab-cursor {
    position: absolute; z-index: 1;
    height: calc(100% - 10px); top: 5px;
    background: rgba(201, 169, 97, 0.15);
    border-radius: 999px;
    transition: left 280ms var(--ease-editorial), width 280ms var(--ease-editorial), opacity 200ms var(--ease-editorial);
    opacity: 0; pointer-events: none;
  }

  .mobile-cta { display: none; }
  @media (max-width: 900px) {
    .slide-tabs { display: none; }
    .mobile-cta {
      display: inline-flex; padding: 10px 18px;
      background: var(--gold-500); color: var(--wine-deep);
      border-radius: 999px; font-family: var(--font-mono);
      font-size: 11px; font-weight: 600; letter-spacing: 1.6px;
      text-transform: uppercase; text-decoration: none;
    }
  }
  @media (max-width: 768px) {
    .site-header .inner { height: 64px; }
  }
</style>

<script>
  // Slide-Tabs Cursor folgt Hover
  const tabsContainer = document.getElementById('slideTabs');
  if (tabsContainer) {
    const cursor = tabsContainer.querySelector('.tab-cursor') as HTMLElement | null;
    const tabs = tabsContainer.querySelectorAll<HTMLElement>('.tab-item');
    tabs.forEach((tab) => {
      tab.addEventListener('mouseenter', () => {
        if (!cursor) return;
        if (tab.classList.contains('cta')) {
          cursor.style.opacity = '0';
          return;
        }
        cursor.style.left = tab.offsetLeft + 'px';
        cursor.style.width = tab.offsetWidth + 'px';
        cursor.style.opacity = '1';
      });
    });
    tabsContainer.addEventListener('mouseleave', () => {
      if (cursor) cursor.style.opacity = '0';
    });
  }

  // Header-Background wird beim Scrollen dunkler
  const header = document.getElementById('siteHeader');
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 60) header.classList.add('scrolled');
      else header.classList.remove('scrolled');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
