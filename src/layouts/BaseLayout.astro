---
/*
  BaseLayout — der globale Wrapper für alle Pages.
  Lädt Google Fonts, setzt Meta-Tags, rendert Header und Footer.

  Verwendung in jeder Page:
    <BaseLayout title="..." description="...">
      <main>...Inhalt...</main>
    </BaseLayout>
*/
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Honorarbasierte Beratung für Geschäftsführer und Vorstände. Corporate Benefits, betriebliche Vorsorge und Executive Compensation. Berlin.',
  ogImage = '/images/og-default.jpg',
} = Astro.props;

const fullTitle = title === 'Dennis Klincov'
  ? 'Dennis Klincov · Berater für Corporate Benefits und Executive Compensation'
  : `${title} · Dennis Klincov`;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content={new URL(ogImage, Astro.site || Astro.url).href} />
  <meta property="og:locale" content="de_DE" />

  <!-- Favicon Placeholder (wir generieren später aus DK-Monogramm) -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts: EB Garamond, Inter, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <Header />
  <slot />
  <Footer />
</body>
</html>
