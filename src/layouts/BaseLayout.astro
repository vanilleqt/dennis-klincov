---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  hideChrome?: boolean;
}

const {
  title,
  description = 'Beratungs-Praxis von Dennis Klincov für Corporate Benefits und Executive Compensation. Mandate werden geprüft, nicht angeboten. Berlin.',
  hideChrome = false,
} = Astro.props;

const siteUrl = 'https://dennis-klincov.com';
const ogImage = `${siteUrl}/images/Dionysus.jpeg`;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={Astro.url.href} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="de_DE" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
  <div id="mouse-gradient"></div>
  {!hideChrome && <Header />}
  <slot />
  {!hideChrome && <Footer />}

  <script>
    // Mouse-Gradient folgt dem Cursor
    const mg = document.getElementById('mouse-gradient');
    let mgTimer: number | undefined;
    document.addEventListener('mousemove', (e) => {
      if (!mg) return;
      mg.style.left = e.clientX + 'px';
      mg.style.top = e.clientY + 'px';
      mg.style.opacity = '1';
      if (mgTimer) clearTimeout(mgTimer);
      mgTimer = window.setTimeout(() => { mg.style.opacity = '0'; }, 1500);
    });
    document.addEventListener('mouseleave', () => {
      if (mg) mg.style.opacity = '0';
    });
  </script>
</body>
</html>
