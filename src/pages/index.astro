</style>

<!-- GSAP + Lenis von CDN -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.42/bundled/lenis.min.js"></script>

<script>
  // === VIDEO RANDOM (Dionysus oder Greek) ===
  const heroVideoSource = document.querySelector('.hero-bg video source') as HTMLSourceElement | null;
  if (heroVideoSource) {
    const videos = ['/videos/Dionysus-video.mp4', '/videos/greek-video.mp4'];
    const selected = videos[Math.floor(Math.random() * videos.length)];
    heroVideoSource.setAttribute('src', selected);
    const videoEl = heroVideoSource.parentElement as HTMLVideoElement | null;
    if (videoEl) videoEl.load();
  }

  // === WORD ANIMATIONS (Hero) ===
  setTimeout(() => {
    document.querySelectorAll<HTMLElement>('.word-animate').forEach((word) => {
      if (word.closest('.pull-section') || word.closest('#dionysusOrbital')) return;
      const delay = parseInt(word.getAttribute('data-delay') || '0', 10);
      setTimeout(() => {
        word.style.animation = 'word-appear 0.8s ease-out forwards';
      }, delay);
    });
  }, 200);

  // === 3D TILT FOR SCHWERPUNKT CARDS ===
  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const rotateX = ((y - rect.height / 2) / (rect.height / 2)) * -4;
      const rotateY = ((x - rect.width / 2) / (rect.width / 2)) * 4;
      card.style.transform = `perspective(1500px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.01)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1500px) rotateX(0) rotateY(0) scale(1)';
    });
  });

  // === GSAP PARALLAX (Hero Background only) ===
  // @ts-ignore — gsap from CDN
  if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    // @ts-ignore
    gsap.registerPlugin(ScrollTrigger);
    const heroBg = document.querySelector('[data-parallax-bg]');
    if (heroBg) {
      // @ts-ignore
      gsap.to(heroBg, {
        yPercent: 18,
        ease: 'none',
        scrollTrigger: {
          trigger: '.parallax',
          start: 'top top',
          end: 'bottom top',
          scrub: 0.5,
        },
      });
    }
    // @ts-ignore — Lenis smooth scroll
    if (typeof Lenis !== 'undefined') {
      // @ts-ignore
      const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
      // @ts-ignore
      lenis.on('scroll', ScrollTrigger.update);
      // @ts-ignore
      gsap.ticker.add((time: number) => { lenis.raf(time * 1000); });
      // @ts-ignore
      gsap.ticker.lagSmoothing(0);
    }
  }

  // === TIMELINE REVEAL (von links nach rechts) ===
  const timeline = document.getElementById('timeline');
  if (timeline) {
    const timelineItems = timeline.querySelectorAll('.timeline-item');
    const timelineObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          timeline.classList.add('revealed');
          timelineItems.forEach((item, i) => {
            setTimeout(() => { item.classList.add('revealed'); }, 200 + i * 180);
          });
          timelineObserver.disconnect();
        }
      });
    }, { threshold: 0.25 });
    timelineObserver.observe(timeline);
  }

  // === PULL-QUOTE REVEAL (aufploppend) ===
  const pullSection = document.getElementById('pullSection');
  if (pullSection) {
    const pullWords = pullSection.querySelectorAll<HTMLElement>('.word-animate');
    const pullObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          pullSection.classList.add('revealed');
          pullWords.forEach((word, i) => {
            setTimeout(() => {
              word.style.animation = 'word-appear 0.8s ease-out forwards';
            }, i * 140);
          });
          pullObserver.disconnect();
        }
      });
    }, { threshold: 0.5 });
    pullObserver.observe(pullSection);
  }

  // === ORBITAL TIMELINE (Dionysus 3 Akte) ===
  const orbitalContainer = document.getElementById('dionysusOrbital');
  if (orbitalContainer) {
    const nodes = orbitalContainer.querySelectorAll<HTMLElement>('.orbital-node');
    const nodeCount = nodes.length;
    const radius = window.innerWidth < 900 ? 130 : 200;
    let rotationAngle = 0;
    let autoRotate = true;
    let activeIdx = -1;
    let lastTime = 0;

    function positionNodes(deltaMs: number) {
      if (autoRotate) {
        rotationAngle = (rotationAngle + (deltaMs * 0.012)) % 360;
      }
      nodes.forEach((node, i) => {
        const angle = ((i / nodeCount) * 360 + rotationAngle) % 360;
        const radian = (angle * Math.PI) / 180;
        const x = Math.cos(radian) * radius;
        const y = Math.sin(radian) * radius;
        const zIndex = Math.round(100 + 50 * Math.cos(radian));
        const opacity = Math.max(0.55, 0.55 + 0.45 * ((1 + Math.sin(radian)) / 2));
        node.style.transform = 'translate(calc(-50% + ' + x + 'px), calc(-50% + ' + y + 'px))';
        if (!node.classList.contains('active')) {
          node.style.zIndex = String(zIndex);
          node.style.opacity = String(opacity);
        } else {
          node.style.zIndex = '300';
          node.style.opacity = '1';
        }
      });
    }

    function tick(t: number) {
      const delta = lastTime ? (t - lastTime) : 16;
      lastTime = t;
      positionNodes(delta);
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    nodes.forEach((node, idx) => {
      node.addEventListener('click', (e) => {
        e.stopPropagation();
        if (activeIdx === idx) {
          node.classList.remove('active');
          activeIdx = -1;
          autoRotate = true;
        } else {
          nodes.forEach((n) => n.classList.remove('active'));
          node.classList.add('active');
          activeIdx = idx;
          autoRotate = false;
          rotationAngle = 270 - (idx / nodeCount) * 360;
        }
      });
    });

    orbitalContainer.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const onStage = target === orbitalContainer
        || target.classList.contains('orbital-stage')
        || target.classList.contains('orbital-orbit')
        || target.classList.contains('orbital-center')
        || target.classList.contains('orbital-core')
        || target.classList.contains('orbital-hint');
      if (onStage) {
        nodes.forEach((n) => n.classList.remove('active'));
        activeIdx = -1;
        autoRotate = true;
      }
    });
  }
</script>
