---
/*
  Dynamisches Detail-Template für alle Themen-Seiten.
  Astro generiert pro Markdown-Datei in content/themen/ eine HTML-Seite.

  URL-Schema: /themen/[slug]/  (z.B. /themen/direktzusage/)
*/
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// getStaticPaths sagt Astro: bau für jedes Themen-Markdown eine eigene Page
export async function getStaticPaths() {
  const themen = await getCollection('themen');
  return themen.map((thema) => ({
    params: { slug: thema.id },
    props: { thema },
  }));
}

const { thema } = Astro.props;
const { Content } = await render(thema);

// Headline darf *italic* enthalten — wir rendern den Asterisk-Block als <em>
const headlineHtml = thema.data.headline.replace(
  /\*(.+?)\*/g,
  '<em>$1</em>'
);
---

<BaseLayout title={thema.data.titel} description={thema.data.description}>

  <!-- =====================================================
       HERO · Indigo-Hintergrund
       ===================================================== -->
  <section class="themen-hero section--indigo">
    <div class="container">
      <div class="themen-hero__inner">
        <div class="eyebrow themen-hero__eyebrow">{thema.data.eyebrow}</div>
        <h1 class="themen-hero__title display-1" set:html={headlineHtml}></h1>
        <p class="themen-hero__lead body-large">{thema.data.lead}</p>

        {thema.data.stats && thema.data.stats.length > 0 && (
          <div class="themen-hero__stats">
            {thema.data.stats.map((stat) => (
              <div class="stat">
                <div class="stat__wert">{stat.wert}</div>
                <div class="stat__label">{stat.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- =====================================================
       INHALT · Markdown-Body
       ===================================================== -->
  <article class="themen-article">
    <div class="container">
      <div class="themen-article__body reading">
        <Content />
      </div>

      <!-- Paragraphen-Liste am Ende (falls vorhanden) -->
      {thema.data.paragraphen && thema.data.paragraphen.length > 0 && (
        <div class="themen-article__paragraphen reading">
          <div class="eyebrow">Rechtsgrundlagen</div>
          <ul class="paragraphen-list">
            {thema.data.paragraphen.map((p) => (
              <li class="mono">{p}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </article>

  <!-- =====================================================
       CTA · zurück zur Übersicht oder Kontakt
       ===================================================== -->
  <section class="section themen-cta">
    <div class="container">
      <div class="themen-cta__inner">
        <h2 class="h2">Beratung zu <em>{thema.data.titel}</em></h2>
        <p class="body-large themen-cta__text">
          30 Minuten Erstgespräch, kostenlos. Wir klären Ihre Situation, ich gebe eine erste Einschätzung.
        </p>
        <div class="themen-cta__actions">
          <a href="/kontakt/" class="btn btn--primary">Gespräch anfragen</a>
          <a href="/themen/" class="btn btn--ghost">← Alle Themen</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* === HERO ===================================== */
  .themen-hero {
    padding: var(--space-3xl) 0 var(--space-4xl);
  }
  .themen-hero__inner {
    max-width: 840px;
  }
  .themen-hero__eyebrow { margin-bottom: var(--space-md); }
  .themen-hero__title {
    color: var(--white);
    margin-bottom: var(--space-lg);
  }
  .themen-hero__title :global(em) {
    color: var(--brass);
    font-style: italic;
  }
  .themen-hero__lead {
    color: rgba(255, 255, 255, 0.78);
    max-width: 720px;
    margin-bottom: var(--space-2xl);
  }

  .themen-hero__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: var(--space-xl);
  }
  .stat {
    background: var(--indigo);
    padding: var(--space-lg) var(--space-md);
  }
  .stat__wert {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 36px;
    line-height: 1;
    color: var(--brass);
    margin-bottom: var(--space-xs);
  }
  .stat__label {
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (max-width: 720px) {
    .themen-hero__stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stat__wert { font-size: 28px; }
  }

  /* === ARTICLE BODY ============================= */
  .themen-article {
    padding: var(--space-4xl) 0;
  }
  .themen-article__body :global(h2) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--indigo);
    margin: var(--space-2xl) 0 var(--space-md);
  }
  .themen-article__body :global(h2:first-child) { margin-top: 0; }
  .themen-article__body :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.3;
    color: var(--indigo);
    margin: var(--space-xl) 0 var(--space-sm);
  }
  .themen-article__body :global(p) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--slate-700);
    margin-bottom: var(--space-md);
  }
  .themen-article__body :global(ul) {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0;
  }
  .themen-article__body :global(ul li) {
    position: relative;
    padding-left: var(--space-lg);
    margin-bottom: var(--space-sm);
    font-size: 17px;
    line-height: 1.65;
    color: var(--slate-700);
  }
  .themen-article__body :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 12px;
    width: 8px;
    height: 2px;
    background: var(--brass);
  }

  /* === PARAGRAPHEN-LISTE ======================== */
  .themen-article__paragraphen {
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--slate-200);
  }
  .paragraphen-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .paragraphen-list li {
    padding: 6px 12px;
    background: var(--bone-warm);
    border: 1px solid var(--brass-soft);
    color: var(--indigo);
    font-size: 12px;
    letter-spacing: 0.5px;
  }

  /* === CTA ====================================== */
  .themen-cta__inner {
    max-width: 640px;
    text-align: center;
    margin: 0 auto;
    padding: var(--space-2xl) 0;
  }
  .themen-cta__inner .h2 { margin-bottom: var(--space-md); }
  .themen-cta__text { color: var(--slate-600); margin-bottom: var(--space-xl); }
  .themen-cta__actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
</style>
